# BrickBank – alle Anfragen auf den Front-Controller leiten.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Bestehende Dateien/Verzeichnisse (Assets) direkt ausliefern.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    # Alles andere an index.php.
    RewriteRule ^ index.php [L]
</IfModule>
